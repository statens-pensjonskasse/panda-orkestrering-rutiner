{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "navn": {
      "type": "string"
    },
    "metainfo": {
      "type": "object",
      "required": [
        "tags",
        "mal",
        "støttetAvPaOrkBa01FraVersjon"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "fakturering",
              "prognose",
              "arkivering",
              "eksport",
              "systemkorreksjon",
              "månedskjøring",
              "to-steg",
              "versjonsisolering",
              "aktuar",
              "agresso",
              "dvh",
              "vedlikehold",
              "sluttfaktura",
              "avregning",
              "premieoppgjør",
              "ad-hoc",
              "gkrs",
              "solvens",
              "metadataBestilling",
              "kontoutskrift",
              "brøytekjøring"
            ]
          }
        },
        "premiemodell": {
          "enum": [
            "hbf_fls",
            "hbf_stat",
            "hbf_as_asa",
            "hbf_ovrige",
            "poa",
            "poa_pen",
            "poa_kjeder",
            "poa_frittstaaende",
            "tjenestemannsorg",
            "tjenestemannsorg_arbeidsgiverandel",
            "ysk",
            "gru"
          ],
          "type": "string"
        },
        "mal": {
          "type": "string"
        },
        "støttetAvPaOrkBa01FraVersjon": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tags": {
                "contains": {
                  "enum": [
                    "fakturering",
                    "prognose",
                    "agresso",
                    "kontoutskrift"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "premiemodell"
            ],
            "message": {
              "required": "Maler tagget med fakturering, prognose, agresso eller kontoutskrift må ha premiemodell i metainfo."
            }
          }
        }
      ]
    },
    "gyldigVersjon": {
      "type": "string"
    },
    "variabler": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "array"]
      }
    },
    "operasjoner": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "handling": {
            "type": "string"
          }
        },
        "required": [
          "handling"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "navn",
    "metainfo",
    "variabler",
    "operasjoner"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "metainfo": {
            "properties": {
              "tags": {
                "contains": {
                  "const": "metadataBestilling"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "variabler": {
            "required": [
              "kjøringsId"
            ],
            "message": {
              "required": "Maler tagget med metadataBestilling må ha variabelen kjøringsId, fordi flytkontroll bruker den til å finne kjøringene i MongoDB."
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}