{
  "navn": "Rutine for initiell fletting av pensjonsgivende månedslønner",
  "metainfo": {
    "mal": "maler/fakturering/ad_hoc/initiell_fletting_av_pensjonsgivende_maanedsloenner.json",
    "tags": [
      "arkivering"
    ],
    "støttetAvPaOrkBa01FraVersjon": "1.6.1"
  },
  "gyldigVersjon": "1.0.0",
  "variabler": {
    "grunnlagsdataMappe": "#{grunnlagsdatamappeNå}",

    "førsteFremskrivingsDato": "<YYYY.MM.dd>",

    "forrigeFremskrivingsDatoer": [
      "<YYYY.MM.dd>",
      "<YYYY.MM.dd>"
    ],
    "fremskrivingsDatoer": [
      "<YYYY.MM.dd>",
      "<YYYY.MM.dd>"

    ],

    "paFakBa11Versjon": "<X.Y.Z>"
  },
  "operasjoner": [
    {
      "handling": "deploy_batch",
      "batcher": [
        {
          "navn": "pa_fak_ba_11",
          "versjon": "${paFakBa11Versjon}"
        }
      ]
    },

    {
      "navn": "Initiell fletting av første måned",
      "handling": "gruppe",
      "gruppeAv": [
        {
          "handling": "rydd_grunnlagsdata_for_batch",
          "batch": "pa_fak_ba_11"
        },
        {
          "handling": "kopier_fra_arkiv_til_batch",
          "filnavn": "pensjonsgivende_maanedsloenn",
          "batchFra": "pa_fak_ba_05",
          "batchTil": "pa_fak_ba_11",
          "grunnlagsdataMappeTil": "${grunnlagsdataMappe}",
          "nøkkel": "generer_pensjonsgivende_maanedsloenn/${forsteFremskrivingsDato}",
          "kommentar": "Henter månedens pensjonsgivende månedslønn"
        },
        {
          "handling": "pa_fak_ba_11",
          "modus": "flette_pensjonsgivende_månedslønner",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}",
          "flettetFremskrivingsdato": "${forsteFremskrivingsDato}",
          "validerFeilendeMedlemmer": true
        },
        {
          "handling": "arkiver_all_batch_output",
          "batch": "pa_fak_ba_11",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}",
          "nøkkel": "flette_pensjonsgivende_maanedsloenner/${forsteFremskrivingsDato}"
        },
        {
          "handling": "rydd_grunnlagsdata_for_batch",
          "batch": "pa_fak_ba_11"
        }
      ]
    },

    {
      "navn": "Fletting av påfølgende måneder (for hver zipped)",
      "handling": "for_hver_zipped",
      "lister": {
        "forrigeFremskrivingsDato": "${forrigeFremskrivingsDatoer}",
        "fremskrivingsDato": "${fremskrivingsDatoer}"
      },
      "utfør_handlinger": [
        {
          "handling": "rydd_grunnlagsdata_for_batch",
          "batch": "pa_fak_ba_11"
        },
        {
          "handling": "kopier_fra_arkiv_til_batch",
          "filnavn": "flettede_pensjonsgivende_maanedsloenner",
          "batchFra": "pa_fak_ba_11",
          "batchTil": "pa_fak_ba_11",
          "grunnlagsdataMappeTil": "${grunnlagsdataMappe}",
          "nøkkel": "flette_pensjonsgivende_maanedsloenner/{{forrigeFremskrivingsDato}}",
          "kommentar": "Henter forrige flettede pensjonsgivende månedslønner for å flette feilende medlemmer"
        },
        {
          "handling": "kopier_fra_arkiv_til_batch",
          "filnavn": "feilmeldinger",
          "batchFra": "pa_res_ba_03",
          "batchTil": "pa_fak_ba_11",
          "grunnlagsdataMappeTil": "${grunnlagsdataMappe}",
          "nøkkel": "panda_pensjonsgivende_loenn/{{fremskrivingsDato}}",
          "kommentar": "Henter nåværende måneds feilmeldinger"
        },
        {
          "handling": "kopier_fra_arkiv_til_batch",
          "filnavn": "pensjonsgivende_maanedsloenn",
          "batchFra": "pa_fak_ba_05",
          "batchTil": "pa_fak_ba_11",
          "grunnlagsdataMappeTil": "${grunnlagsdataMappe}",
          "nøkkel": "generer_pensjonsgivende_maanedsloenn/{{fremskrivingsDato}}",
          "kommentar": "Henter nåværende måneds pensjonsgivende månedslønner"
        },
        {
          "handling": "pa_fak_ba_11",
          "modus": "flette_pensjonsgivende_månedslønner",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}",
          "flettetFremskrivingsdato": "{{fremskrivingsDato}}",
          "validerFeilendeMedlemmer": true
        },
        {
          "handling": "arkiver_all_batch_output",
          "batch": "pa_fak_ba_11",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}",
          "nøkkel": "flette_pensjonsgivende_maanedsloenner/{{fremskrivingsDato}}"
        },
        {
          "handling": "rydd_grunnlagsdata_for_batch",
          "batch": "pa_fak_ba_11"
        }
      ]
    }
  ]
}