{
  "navn": "Bestilling av GKRS for regnskapsår ${regnskapsAar}, og generering av excel-fil",
  "metainfo": {
    "mal": "maler/gkrs/hbf_fls/bestill_gkrs.json",
    "tags": ["gkrs"],
    "premiemodell": "hbf_fls",
    "støttetAvPaOrkBa01FraVersjon": "0.0.60"
  },
  "variabler": {
    "grunnlagsdataMappe": "#{grunnlagsdatamappeNå}",
    "checksumGkrs": "<checksumGrks>",
    "checksumForutsetninger": "<checksumForutsetninger>",
    "checksumPrismodell": "<checksumPrismodell>",
    "regnskapsAar": "<yyyy>",
    "paDokBa01Versjon": "<X.Y.Z>",
    "paDokBa02Versjon": "<X.Y.Z>"
  },
  "operasjoner": [
    {
      "handling": "deploy_batch",
      "batcher": [
        {
          "navn": "pa_dok_ba_01",
          "versjon": "${paDokBa01Versjon}"
        },
        {
          "navn": "pa_dok_ba_02",
          "versjon": "${paDokBa02Versjon}"
        }
      ]
    },
    {
      "navn": "Rydd grunnlagsdata for batchene pa_dok_ba_01 og pa_dok_ba_02",
      "handling": "gruppe",
      "gruppeAv": [
        {
          "handling": "rydd_grunnlagsdata_for_batch",
          "batch": "pa_dok_ba_01"
        },
        {
          "handling": "rydd_grunnlagsdata_for_batch",
          "batch": "pa_dok_ba_02"
        }
      ]
    },
    {
      "navn": "pa_dok_ba_01 berik GKRS for regnskapsår ${regnskapsAar}",
      "handling": "gruppe",
      "gruppeAv": [
        {
          "handling": "kopier_fil_fra_arkiv_aktuar_til_batch",
          "gruppe": "gkrs",
          "premiemodell": "hbf_fls",
          "periode": "${regnskapsAar}",
          "kategori": "forutsetninger",
          "checksum": "${checksumForutsetninger}",
          "batch": "pa_dok_ba_01",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}"
        },
        {
          "handling": "kopier_fil_fra_arkiv_aktuar_til_batch",
          "gruppe": "gkrs",
          "premiemodell": "hbf_fls",
          "periode": "${regnskapsAar}",
          "checksum": "${checksumGkrs}",
          "kategori": "gkrs",
          "batch": "pa_dok_ba_01",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}"
        },
        {
          "handling": "pa_dok_ba_01",
          "modus": "sammenstill_gkrs",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}"
        },
        {
          "handling": "arkiver_all_batch_output",
          "batch": "pa_dok_ba_01",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}",
          "nøkkel": "sammenstill_gkrs/${regnskapsAar}"
        }
      ]
    },
    {
      "navn": "pa_dok_ba_02 generere excel fil for gkrs ${regnskapsAar}",
      "handling": "gruppe",
      "gruppeAv": [
        {
          "handling": "rydd_grunnlagsdata_for_batch",
          "batch": "pa_dok_ba_02"
        },
        {
          "handling": "kopier_fra_arkiv_til_batch",
          "filnavn": "gkrs_beriket",
          "batchFra": "pa_dok_ba_01",
          "batchTil": "pa_dok_ba_02",
          "nøkkel": "sammenstill_gkrs/${regnskapsAar}",
          "grunnlagsdataMappeFra": "${grunnlagsdataMappe}"
        },
        {
          "handling": "pa_dok_ba_02",
          "modus": "generer_gkrs_dokumenter",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}"
        },
        {
          "handling": "arkiver_all_batch_output",
          "batch": "pa_dok_ba_02",
          "grunnlagsdataMappe": "${grunnlagsdataMappe}",
          "nøkkel": "generer_gkrs_dokumenter/${regnskapsAar}"
        },
        {
          "handling": "rydd_grunnlagsdata_for_batch",
          "batch": "pa_dok_ba_02"
        }
      ]
    }
  ]
}
